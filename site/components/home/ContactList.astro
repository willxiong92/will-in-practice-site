---
import { profile } from '../../data/profile';

// Contact is GitHub only (D-015): no email, no IM handles.
const links = [
  { label: 'GitHub', value: `@${profile.github.handle}`, href: profile.github.url },
  { label: '本站源码', value: 'will-in-practice-site', href: `${profile.github.url}/will-in-practice-site` },
];
---
<ul class="contact-list">
  {links.map((link, index) => (
    <li data-reveal style={`--d: ${index * 70}ms`}>
      <a href={link.href} target="_blank" rel="noopener noreferrer">
        <span class="contact-idx" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="contact-label"><span class="hl-bar">{link.label}</span></span>
        <span class="contact-value">{link.value}</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>
