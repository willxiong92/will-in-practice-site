---
import type { Repo, Work } from '../../lib/data';
import { formatMonth, isPreview } from '../../lib/data';
import Illo from './Illo.astro';

interface Props {
  work: Work;
  /** Registry entry for the linked repo, public or not. */
  repo?: Repo;
  index: number;
}

const { work, repo, index } = Astro.props;
const { title, summary, scenario, result, tools, illustration, date, status, approved } = work.data;
const number = String(index + 1).padStart(2, '0');
// The card links out only when the repo is public on GitHub; a private one stays unlinked.
const repoUrl = repo?.data.visibility === 'public' ? repo.data.url : undefined;
---
<article class:list={['card', 'card-product', repoUrl && 'is-link']} data-card="work">
  <Illo src={illustration} variant="stage" ratio="16:9" />
  <div class="card-body">
    <p class="card-meta">
      <span class="meta">{status}</span>
      <span class="meta">{formatMonth(date)}</span>
      {isPreview && !approved && <span class="badge" data-preview>文案待审</span>}
      {isPreview && repo && !repoUrl && <span class="badge" data-preview>仓库未公开</span>}
    </p>
    <h4 class="card-title title-lg">
      {repoUrl ? (
        <a class="card-link" href={repoUrl} target="_blank" rel="noopener noreferrer">
          <span class="hl-bar">{title}</span><span class="sr-only">（打开仓库）</span>
        </a>
      ) : (
        <span class="hl-bar">{title}</span>
      )}
    </h4>
    <p class="card-summary">{summary}</p>
    <p class="card-note"><span class="note-label">起因</span>{scenario}</p>
    {result && <p class="card-note"><span class="note-label">效果</span>{result}</p>}
    <ul class="chips" aria-label="用到的工具">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
    {/* Cue only: the stretched link above already covers the whole card. */}
    {repoUrl && <p class="card-foot meta">看仓库 <span class="arrow" aria-hidden="true">↗</span></p>}
  </div>
  <span class="outline-num card-no" aria-hidden="true">{number}</span>
</article>
